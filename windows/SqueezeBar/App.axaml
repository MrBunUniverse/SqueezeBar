<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SqueezeBar.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Themes.Fluent/FluentTheme.axaml" />
    </Application.Styles>

    <Application.Resources>
        <Color x:Key="AccentColor">#00D2FF</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D2FF" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#16181D" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2A2D36" />
        <x:Double x:Key="SliderThumbWidth">11</x:Double>
        <x:Double x:Key="SliderThumbHeight">11</x:Double>
        <x:Double x:Key="SliderThumbWidthPointerOver">11</x:Double>
        <x:Double x:Key="SliderThumbHeightPointerOver">11</x:Double>
        <x:Double x:Key="SliderThumbWidthPressed">11</x:Double>
        <x:Double x:Key="SliderThumbHeightPressed">11</x:Double>
    </Application.Resources>
</Application>