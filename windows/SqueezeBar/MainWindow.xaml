<Window
    x:Class="SqueezeBar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Laid out at the Mac popover's 490 x 660 and scaled as a whole for the 85% / 118% interface sizes. -->
    <Viewbox Stretch="Uniform">
    <Grid x:Name="Root" Width="490" Height="660" Background="#01000000" AllowDrop="True"
          DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="V" Invoked="OnPasteAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="1" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header (drags the window while pinned) -->
        <Grid x:Name="Header" Padding="20,14,18,12" Background="Transparent" PointerPressed="OnHeaderPressed" PointerMoved="OnHeaderMoved" PointerReleased="OnHeaderReleased" PointerCaptureLost="OnHeaderCaptureLost">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="1" VerticalAlignment="Center">
                <!-- The animated S mark stands in for the "S" of the name. -->
                <StackPanel Orientation="Horizontal" Spacing="1" AutomationProperties.Name="SqueezeBar">
                    <Viewbox x:Name="HeaderMark" Width="17" Height="20" VerticalAlignment="Bottom" Margin="0,0,0,5">
                        <Canvas x:Name="HeaderMarkCanvas" Width="576" Height="684" />
                    </Viewbox>
                    <TextBlock Text="queezeBar" FontSize="19" FontWeight="Bold" CharacterSpacing="22" />
                </StackPanel>
                <TextBlock x:Name="Subtitle" Text="Universal Media Optimizer" FontSize="11" Foreground="{StaticResource Secondary}" />
            </StackPanel>

            <Border x:Name="StatusBadge" Grid.Column="1" Visibility="Collapsed" CornerRadius="10" Padding="7,3" Margin="0,0,8,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <ProgressRing x:Name="StatusRing" Width="12" Height="12" MinWidth="12" MinHeight="12" IsActive="True" />
                    <FontIcon x:Name="StatusCheck" FontFamily="{StaticResource Icons}" Glyph="&#xE73E;" FontSize="10.5" />
                    <TextBlock x:Name="StatusText" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button x:Name="CancelAllButton" Style="{StaticResource Plain}" Click="OnCancelAll"
                            AutomationProperties.Name="Cancel All Compression" ToolTipService.ToolTip="Cancel All Compression">
                        <FontIcon FontFamily="{StaticResource Icons}" Glyph="&#xE711;" FontSize="10" Foreground="{StaticResource Secondary}" />
                    </Button>
                </StackPanel>
            </Border>

            <Button x:Name="PinButton" Grid.Column="2" Style="{StaticResource Plain}" Click="OnPin"
                    Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                    Background="#14FFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                    AutomationProperties.Name="Keep Open" ToolTipService.ToolTip="Keep open as a floating window">
                <FontIcon x:Name="PinIcon" FontFamily="{StaticResource Icons}" Glyph="&#xE718;" FontSize="11" Opacity="0.85" />
            </Button>
        </Grid>
        <Rectangle Grid.Row="1" Fill="#1AFFFFFF" />

        <!-- Tab selector -->
        <Border Grid.Row="2" Margin="18,8,18,4" Padding="2" CornerRadius="16"
                Background="#3D000000" BorderBrush="#14FFFFFF" BorderThickness="1">
            <Grid ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button x:Name="ActivityTab" Style="{StaticResource Plain}" Click="OnActivityTab" AutomationProperties.Name="Activity" MinHeight="28" CornerRadius="14"
                        BorderThickness="1" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource Icons}" Glyph="&#xE945;" FontSize="11" />
                        <TextBlock Text="Activity" FontSize="12.5" />
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsTab" Grid.Column="1" Style="{StaticResource Plain}" Click="OnSettingsTab" AutomationProperties.Name="Settings" MinHeight="28" CornerRadius="14"
                        BorderThickness="1" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="{StaticResource Icons}" Glyph="&#xE713;" FontSize="11" />
                        <TextBlock Text="Settings" FontSize="12.5" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Activity -->
        <ScrollViewer x:Name="ActivityView" Grid.Row="3">
            <StackPanel Spacing="14" Margin="18,8,18,18">
                <Grid x:Name="TilesRow" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                </Grid>
                <Border x:Name="Drawer" Visibility="Collapsed" CornerRadius="12" Padding="10"
                        Background="#40000000" BorderBrush="#12FFFFFF" BorderThickness="1" />

                <StackPanel x:Name="JobsPanel" Spacing="8" Visibility="Collapsed" />

                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Recent" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="RecentMenu" Style="{StaticResource Plain}" HorizontalAlignment="Right" Width="28" Height="28" CornerRadius="6"
                                AutomationProperties.Name="Recent actions" ToolTipService.ToolTip="Recent actions">
                            <FontIcon FontFamily="{StaticResource Icons}" Glyph="&#xE712;" FontSize="12" Foreground="{StaticResource Secondary}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem x:Name="ClearHistoryItem" Text="Clear History" Click="OnClearHistory">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="{StaticResource Icons}" Glyph="&#xE74D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <Button x:Name="DropZone" Style="{StaticResource Plain}" Click="OnChooseFiles" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="12"
                            AutomationProperties.Name="Drop files to squeeze, or click to choose"
                            ToolTipService.ToolTip="Drop files here, or click to choose files to compress">
                        <Grid x:Name="ZoneGrid" MinHeight="218">
                            <Rectangle x:Name="ZoneOutline" RadiusX="12" RadiusY="12" Fill="#05FFFFFF"
                                       Stroke="#1FFFFFFF" StrokeThickness="1" StrokeDashArray="4 4" />
                            <StackPanel Spacing="12" VerticalAlignment="Center" Margin="14">
                                <Viewbox x:Name="Mark" Width="48" Height="57">
                                    <Canvas x:Name="MarkCanvas" Width="576" Height="684" />
                                </Viewbox>
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="ZoneTitle" Text="Drop files to squeeze" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="ZoneDetail" Text="Compresses immediately with your current presets" FontSize="11"
                                               Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock x:Name="ZoneHint" Text="Images · Video · Audio · PDF, or click to choose" FontSize="10.5"
                                           Foreground="{StaticResource Secondary}" Opacity="0.85" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="ClipboardButton" Style="{StaticResource Plain}" Click="OnSqueezeClipboard" AutomationProperties.Name="Squeeze from Clipboard" HorizontalAlignment="Center" Padding="8,4" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="{StaticResource Icons}" Glyph="&#xE77F;" FontSize="11" Foreground="{StaticResource Secondary}" />
                            <TextBlock Text="Squeeze from Clipboard" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Secondary}" />
                            <TextBlock Text="Ctrl+V" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Secondary}" Opacity="0.7" />
                        </StackPanel>
                    </Button>
                    <StackPanel x:Name="QueueHost" />
                    <StackPanel x:Name="HistoryPanel" Spacing="6" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Settings (built in SettingsView.cs) -->
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="3" Visibility="Collapsed">
            <StackPanel x:Name="SettingsPanel" Spacing="14" Margin="18,8,18,18" />
        </ScrollViewer>

        <Rectangle Grid.Row="4" Fill="#1AFFFFFF" />

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="18,8">
            <TextBlock Text="SqueezeBar v1.1.0 • SirJameTV" FontSize="10.5" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
            <Button Style="{StaticResource Plain}" Click="OnQuit" AutomationProperties.Name="Quit" HorizontalAlignment="Right" Padding="6,2" CornerRadius="6">
                <TextBlock Text="Quit" FontSize="10.5" FontWeight="Medium" Foreground="{StaticResource Secondary}" />
            </Button>
        </Grid>

    </Grid>
    </Viewbox>
</Window>
