<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SqueezeBar.Models"
        xmlns:services="clr-namespace:SqueezeBar.Services"
        x:Class="SqueezeBar.Views.MainWindow"
        Title="SqueezeBar"
        Width="490" Height="720"
        MinWidth="490" MinHeight="720"
        MaxWidth="490" MaxHeight="720"
        CanResize="False"
        WindowState="Normal"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A1E"
        Foreground="#E8E8ED">

    <Window.Resources>
        <x:Double x:Key="SliderThumbWidth">11</x:Double>
        <x:Double x:Key="SliderThumbHeight">11</x:Double>
        <x:Double x:Key="SliderThumbWidthPointerOver">12</x:Double>
        <x:Double x:Key="SliderThumbHeightPointerOver">12</x:Double>
        <x:Double x:Key="SliderThumbWidthPressed">12</x:Double>
        <x:Double x:Key="SliderThumbHeightPressed">12</x:Double>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="16"/>
        </Style>
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="CornerRadius" Value="5.5"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="Slider:horizontal /template/ Thumb#thumb">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="CornerRadius" Value="5.5"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="Slider:pointerover /template/ Thumb">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="Slider:pressed /template/ Thumb">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- Ultra-Minimalist Micro CheckBox (1:1 Proportional & Centered) -->
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*" Background="Transparent" VerticalAlignment="Center">
                        <Border Name="CheckBorder"
                                Width="11" Height="11"
                                CornerRadius="2.5"
                                BorderThickness="0.8"
                                BorderBrush="#3E3E48"
                                Background="#1A1A1E"
                                VerticalAlignment="Center">
                            <Viewbox Width="6.5" Height="6.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Name="CheckGlyph"
                                      Data="M 1 4.5 L 3.5 7 L 8.5 1.5"
                                      Stroke="#000000"
                                      StrokeThickness="1.8"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      IsVisible="False"/>
                            </Viewbox>
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          Margin="6,0,0,0"
                                          FontSize="9"
                                          Foreground="#8E8E9E"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#CheckBorder">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#CheckBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        </Style>
        <Style Selector="CheckBox:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#E8E8ED"/>
        </Style>
    </Window.Styles>

    <!-- All colors are pre-composited solid opaques for Wine/CrossOver compatibility -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ════════════════════════════════════════════════════ -->
        <!-- 1. HEADER                                           -->
        <!-- ════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,0">
            <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="SqueezeBar" FontSize="14" FontWeight="Bold" Foreground="#F0F0F5" FontFamily="Georgia, 'Times New Roman', serif"/>
                    <TextBlock Text="Universal Media Optimizer" FontSize="9" Foreground="#6B6B78"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border x:Name="ProcessingBadge" Background="#1A2E28" CornerRadius="10" Padding="8,3" IsVisible="False">
                    <TextBlock Text="Optimizing..." FontSize="9" FontWeight="SemiBold" Foreground="#4ADE80"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ════════════════════════════════════════════════════ -->
        <!-- 2. TAB GLIDER BAR (1:1 macOS Capsule Style)         -->
        <!-- ════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="#141418" CornerRadius="20" Margin="20,12,20,0" Padding="3" BorderBrush="#27272B" BorderThickness="0.5">
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" x:Name="ActivityTabBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="0,6.5" CornerRadius="17" Background="#2A2A2F" BorderBrush="#353539" BorderThickness="0.5" Click="ActivityTab_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="10.5" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Activity" FontSize="11.5" FontWeight="SemiBold" Foreground="#F0F0F5"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" x:Name="SettingsTabBtn" Width="30" Height="30" CornerRadius="15" Margin="3,0,0,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="SettingsTab_Click">
                    <TextBlock Text="⚙" FontSize="13" Foreground="#888898" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════ -->
        <!-- 3. SCROLLABLE CONTENT AREA                          -->
        <!-- ════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="2" Margin="0,10,0,0" Padding="20,0,20,14">
            <StackPanel Spacing="10">

                <!-- ━━━━ ACTIVITY TAB ━━━━ -->
                <StackPanel x:Name="ActivityTabPanel" Spacing="10">

                    <!-- 4 Live Format Profile Tiles -->
                    <Grid ColumnDefinitions="*,*,*,*">
                        <!-- Images -->
                        <Border Grid.Column="0" x:Name="ImagesTileBorder" Margin="0,0,3,0" Background="#222226" CornerRadius="9" Padding="9,9" MinHeight="64" BorderBrush="#2D2D32" BorderThickness="0.5" Cursor="Hand" PointerPressed="SelectImagesCategory_PointerPressed">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="ImagesTitleText" Text="Images" FontSize="9.5" FontWeight="Bold" Foreground="#B0B0BE" FontFamily="Georgia, 'Times New Roman', serif"/>
                                    <TextBlock Grid.Column="1" x:Name="ImagesChevron" Text="▼" FontSize="7" Foreground="#55556A"/>
                                </Grid>
                                <TextBlock x:Name="ImagesTileFormat" Text="Preserve Original" FontSize="10" FontWeight="SemiBold" Foreground="#E8E8ED"/>
                                <TextBlock x:Name="ImagesTileQuality" Text="80% Quality • 100% Scale" FontSize="8" Foreground="#6B6B78"/>
                            </StackPanel>
                        </Border>

                        <!-- Video -->
                        <Border Grid.Column="1" x:Name="VideoTileBorder" Margin="2,0,2,0" Background="#222226" CornerRadius="9" Padding="9,9" MinHeight="64" BorderBrush="#2D2D32" BorderThickness="0.5" Cursor="Hand" PointerPressed="SelectVideoCategory_PointerPressed">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="VideoTitleText" Text="Video" FontSize="9.5" FontWeight="Bold" Foreground="#B0B0BE" FontFamily="Georgia, 'Times New Roman', serif"/>
                                    <TextBlock Grid.Column="1" x:Name="VideoChevron" Text="▼" FontSize="7" Foreground="#55556A"/>
                                </Grid>
                                <TextBlock x:Name="VideoTileCodec" Text="HEVC • Original" FontSize="10" FontWeight="SemiBold" Foreground="#E8E8ED"/>
                                <TextBlock x:Name="VideoTileQuality" Text="70% Quality • 100% Scale" FontSize="8" Foreground="#6B6B78"/>
                            </StackPanel>
                        </Border>

                        <!-- Audio -->
                        <Border Grid.Column="2" x:Name="AudioTileBorder" Margin="2,0,2,0" Background="#222226" CornerRadius="9" Padding="9,9" MinHeight="64" BorderBrush="#2D2D32" BorderThickness="0.5" Cursor="Hand" PointerPressed="SelectAudioCategory_PointerPressed">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="AudioTitleText" Text="Audio" FontSize="9.5" FontWeight="Bold" Foreground="#B0B0BE" FontFamily="Georgia, 'Times New Roman', serif"/>
                                    <TextBlock Grid.Column="1" x:Name="AudioChevron" Text="▼" FontSize="7" Foreground="#55556A"/>
                                </Grid>
                                <TextBlock x:Name="AudioTileBitrate" Text="192 kbps" FontSize="10" FontWeight="SemiBold" Foreground="#E8E8ED"/>
                                <TextBlock x:Name="AudioTileSubtitle" Text="AAC Stereo" FontSize="8" Foreground="#6B6B78"/>
                            </StackPanel>
                        </Border>

                        <!-- PDF -->
                        <Border Grid.Column="3" x:Name="PdfTileBorder" Margin="3,0,0,0" Background="#222226" CornerRadius="9" Padding="9,9" MinHeight="64" BorderBrush="#2D2D32" BorderThickness="0.5" Cursor="Hand" PointerPressed="SelectPdfCategory_PointerPressed">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="PdfTitleText" Text="PDF" FontSize="9.5" FontWeight="Bold" Foreground="#B0B0BE" FontFamily="Georgia, 'Times New Roman', serif"/>
                                    <TextBlock Grid.Column="1" x:Name="PdfChevron" Text="▼" FontSize="7" Foreground="#55556A"/>
                                </Grid>
                                <TextBlock x:Name="PdfTileDpi" Text="150 DPI" FontSize="10" FontWeight="SemiBold" Foreground="#E8E8ED"/>
                                <TextBlock x:Name="PdfTileSubtitle" Text="Optimized" FontSize="8" Foreground="#6B6B78"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── Collapsible Format Configuration Deck (1:1 macOS Parity) ── -->
                    <Border x:Name="FormatDrawerBorder" Background="#1F1F23" CornerRadius="12" Padding="12" BorderBrush="#27272B" BorderThickness="0.5">
                        <StackPanel Spacing="9">

                            <!-- Deck Header -->
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                                <TextBlock x:Name="DrawerCategoryTitle" Text="Video Settings" FontSize="12.5" FontWeight="Bold" Foreground="#F0F0F5" FontFamily="Georgia, 'Times New Roman', serif" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Padding="0" Background="Transparent" BorderThickness="0" Click="CloseDrawer_Click">
                                    <Border Background="#28282C" CornerRadius="12" Padding="10,3.5" BorderBrush="#2D2D32" BorderThickness="0.5">
                                        <TextBlock Text="Done ▲" FontSize="9.5" FontWeight="SemiBold" Foreground="#A0A0B0"/>
                                    </Border>
                                </Button>
                            </Grid>

                            <!-- 1. Target Size Limit Card (Shared) -->
                            <Border Background="#18181C" CornerRadius="8" Padding="10" BorderBrush="#242428" BorderThickness="0.5">
                                <StackPanel Spacing="7">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Target Size Limit" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                        <TextBlock Grid.Column="1" x:Name="TargetLimitDisplay" Text="≤ 25 MB" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>

                                    <!-- Limit Mode Pills -->
                                    <Grid ColumnDefinitions="*,*,*,*,*,*">
                                        <Button Grid.Column="0" x:Name="PresetOffBtn" Content="Manual" Margin="0,0,1,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="8.5" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="PresetOff_Click"/>
                                        <Button Grid.Column="1" x:Name="Preset50Btn" Content="50 MB" Margin="1,0,1,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="8.5" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Preset50_Click"/>
                                        <Button Grid.Column="2" x:Name="Preset25Btn" Content="25 MB" Margin="1,0,1,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="8.5" FontWeight="SemiBold" Background="{DynamicResource AccentBrush}" Foreground="#000000" CornerRadius="12" Padding="0,4" Click="Preset25_Click"/>
                                        <Button Grid.Column="3" x:Name="Preset10Btn" Content="10 MB" Margin="1,0,1,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="8.5" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Preset10_Click"/>
                                        <Button Grid.Column="4" x:Name="Preset2Btn" Content="2 MB" Margin="1,0,1,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="8.5" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Preset2_Click"/>
                                        <Button Grid.Column="5" x:Name="PresetCustomBtn" Content="Custom" Margin="1,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="8.5" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="PresetCustom_Click"/>
                                    </Grid>

                                    <!-- Custom MB Slider -->
                                    <StackPanel x:Name="CustomTargetSizePanel" Spacing="3" IsVisible="False">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Custom Max Size" FontSize="9" Foreground="#6B6B78"/>
                                            <TextBlock Grid.Column="1" x:Name="CustomTargetSizeLabel" Text="25 MB" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                        <Slider x:Name="CustomTargetSizeSlider" Minimum="1" Maximum="200" Value="25" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    </StackPanel>

                                    <!-- Automation Toggles with Subtitles -->
                                    <StackPanel x:Name="TargetAutomationTogglesPanel" Spacing="5" Margin="0,2,0,0">
                                        <StackPanel Spacing="1">
                                            <CheckBox x:Name="LockResolutionCheck" Content="Lock Original Resolution" IsChecked="True"/>
                                            <TextBlock Text="Allows smart downscaling + bitrate reduction" FontSize="7.5" Foreground="#606070" Margin="17,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel x:Name="LockAudioPanel" Spacing="1">
                                            <CheckBox x:Name="LockAudioCheck" Content="Lock Original Audio Quality" IsChecked="False"/>
                                            <TextBlock Text="Dynamically scales audio to maximize video quality" FontSize="7.5" Foreground="#606070" Margin="17,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 2. VIDEO DECK -->
                            <StackPanel x:Name="VideoDeckPanel" Spacing="8">
                                <!-- Video Bitrate Card -->
                                <Border Background="#18181C" CornerRadius="8" Padding="10" BorderBrush="#242428" BorderThickness="0.5">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Video Bitrate" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                            <TextBlock Grid.Column="1" x:Name="VidBitratePercentText" Text="70% of source" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                        <Slider x:Name="VidQualitySlider" Minimum="0.10" Maximum="1.0" Value="0.70" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <!-- Preset Pills -->
                                        <Grid ColumnDefinitions="*,*,*">
                                            <Button Grid.Column="0" x:Name="VidPresetMaxBtn" Content="Max Compression" Margin="0,0,2,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="VidPresetMax_Click"/>
                                            <Button Grid.Column="1" x:Name="VidPresetBalBtn" Content="Balanced" Margin="2,0,2,0" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AccentBrush}" Foreground="#000000" CornerRadius="12" Padding="0,4" Click="VidPresetBal_Click"/>
                                            <Button Grid.Column="2" x:Name="VidPresetLosslessBtn" Content="Visually Lossless" Margin="2,0,0,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="VidPresetLossless_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Resolution Scale Card -->
                                <Border Background="#18181C" CornerRadius="8" Padding="10" BorderBrush="#242428" BorderThickness="0.5">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Resolution Scale" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                            <TextBlock Grid.Column="1" x:Name="VidResolutionScaleText" Text="Original (100%)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                        <Slider x:Name="VidScaleSlider" Minimum="0.25" Maximum="1.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <Grid ColumnDefinitions="*,*,*,*">
                                            <Button Grid.Column="0" x:Name="VidScale25Btn" Content="25%" Margin="0,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="VidScale25_Click"/>
                                            <Button Grid.Column="1" x:Name="VidScale50Btn" Content="50%" Margin="1,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="VidScale50_Click"/>
                                            <Button Grid.Column="2" x:Name="VidScale75Btn" Content="75%" Margin="1,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="VidScale75_Click"/>
                                            <Button Grid.Column="3" x:Name="VidScale100Btn" Content="Original" Margin="1,0,0,0" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AccentBrush}" Foreground="#000000" CornerRadius="12" Padding="0,4" Click="VidScale100_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Framerate (FPS) Card -->
                                <Border Background="#18181C" CornerRadius="8" Padding="10" BorderBrush="#242428" BorderThickness="0.5">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Framerate (FPS)" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                            <TextBlock Grid.Column="1" x:Name="VidFramerateText" Text="Original" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                        <!-- FPS Pills -->
                                        <Grid ColumnDefinitions="*,*,*,*,*,*,*,*">
                                            <Button Grid.Column="0" x:Name="FpsOrigBtn" Content="Original" Margin="0,0,1,0" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AccentBrush}" Foreground="#000000" CornerRadius="10" Padding="0,3.5" Click="FpsOrig_Click"/>
                                            <Button Grid.Column="1" x:Name="Fps60Btn" Content="60" Margin="1,0,1,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="10" Padding="0,3.5" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Fps60_Click"/>
                                            <Button Grid.Column="2" x:Name="Fps50Btn" Content="50" Margin="1,0,1,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="10" Padding="0,3.5" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Fps50_Click"/>
                                            <Button Grid.Column="3" x:Name="Fps30Btn" Content="30" Margin="1,0,1,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="10" Padding="0,3.5" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Fps30_Click"/>
                                            <Button Grid.Column="4" x:Name="Fps25Btn" Content="25" Margin="1,0,1,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="10" Padding="0,3.5" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Fps25_Click"/>
                                            <Button Grid.Column="5" x:Name="Fps24Btn" Content="24" Margin="1,0,1,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="10" Padding="0,3.5" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Fps24_Click"/>
                                            <Button Grid.Column="6" x:Name="Fps15Btn" Content="15" Margin="1,0,1,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="10" Padding="0,3.5" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Fps15_Click"/>
                                            <Button Grid.Column="7" x:Name="Fps12Btn" Content="12" Margin="1,0,0,0" FontSize="8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="10" Padding="0,3.5" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Fps12_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Format / Codec Card -->
                                <Border Background="#18181C" CornerRadius="8" Padding="10" BorderBrush="#242428" BorderThickness="0.5">
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="Format / Codec" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                        <Grid ColumnDefinitions="*,*,*">
                                            <Button Grid.Column="0" x:Name="CodecHevcBtn" Content="HEVC / H.265" Margin="0,0,2,0" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="{DynamicResource AccentBrush}" Foreground="#000000" CornerRadius="12" Padding="0,4" Click="CodecHevc_Click"/>
                                            <Button Grid.Column="1" x:Name="CodecH264Btn" Content="H.264 / AVC" Margin="2,0,2,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="CodecH264_Click"/>
                                            <Button Grid.Column="2" x:Name="CodecGifBtn" Content="Animated GIF" Margin="2,0,0,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="CodecGif_Click"/>
                                        </Grid>
                                        <CheckBox x:Name="RemoveAudioCheck" Content="Mute / Remove Audio Track" IsChecked="False" FontSize="9.5" Foreground="#A0A0B0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 3. IMAGES DECK -->
                            <StackPanel x:Name="ImagesDeckPanel" Spacing="8" IsVisible="False">
                                <!-- Image Quality Card -->
                                <Border Background="#18181C" CornerRadius="8" Padding="10" BorderBrush="#242428" BorderThickness="0.5">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Image Quality" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                            <TextBlock Grid.Column="1" x:Name="ImgQualityPercentText" Text="80%" FontSize="10.5" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                        </Grid>
                                        <Slider x:Name="ImgQualitySlider" Minimum="0.10" Maximum="1.0" Value="0.80" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <Grid ColumnDefinitions="*,*,*">
                                            <Button Grid.Column="0" x:Name="ImgPresetMaxBtn" Content="Max Compression" Margin="0,0,2,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="ImgPresetMax_Click"/>
                                            <Button Grid.Column="1" x:Name="ImgPresetBalBtn" Content="Balanced" Margin="2,0,2,0" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#00D2FF" Foreground="#000000" CornerRadius="12" Padding="0,4" Click="ImgPresetBal_Click"/>
                                            <Button Grid.Column="2" x:Name="ImgPresetLosslessBtn" Content="Visually Lossless" Margin="2,0,0,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="ImgPresetLossless_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Resolution Scale Card -->
                                <Border Background="#18181C" CornerRadius="8" Padding="10" BorderBrush="#242428" BorderThickness="0.5">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Resolution Scale" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                            <TextBlock Grid.Column="1" x:Name="ImgResolutionScaleText" Text="Original (100%)" FontSize="10.5" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                        </Grid>
                                        <Slider x:Name="ImgScaleSlider" Minimum="0.25" Maximum="1.0" Value="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        <Grid ColumnDefinitions="*,*,*,*">
                                            <Button Grid.Column="0" x:Name="ImgScale25Btn" Content="25%" Margin="0,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="ImgScale25_Click"/>
                                            <Button Grid.Column="1" x:Name="ImgScale50Btn" Content="50%" Margin="1,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="ImgScale50_Click"/>
                                            <Button Grid.Column="2" x:Name="ImgScale75Btn" Content="75%" Margin="1,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="ImgScale75_Click"/>
                                            <Button Grid.Column="3" x:Name="ImgScale100Btn" Content="Original" Margin="1,0,0,0" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#00D2FF" Foreground="#000000" CornerRadius="12" Padding="0,4" Click="ImgScale100_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Format Target Card -->
                                <Border Background="#18181C" CornerRadius="8" Padding="10" BorderBrush="#242428" BorderThickness="0.5">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Format Target" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                        <Grid ColumnDefinitions="*,*,*">
                                            <Button Grid.Column="0" x:Name="ImgFmtWebpBtn" Content="Modern WebP" Margin="0,0,2,0" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#00D2FF" Foreground="#000000" CornerRadius="12" Padding="0,4" Click="ImgFmtWebp_Click"/>
                                            <Button Grid.Column="1" x:Name="ImgFmtJpegBtn" Content="Web JPEG" Margin="2,0,2,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="ImgFmtJpeg_Click"/>
                                            <Button Grid.Column="2" x:Name="ImgFmtOrigBtn" Content="Preserve Original" Margin="2,0,0,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="ImgFmtOrig_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 4. AUDIO DECK -->
                            <StackPanel x:Name="AudioDeckPanel" Spacing="8" IsVisible="False">
                                <Border Background="#18181C" CornerRadius="8" Padding="10" BorderBrush="#242428" BorderThickness="0.5">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Audio Bitrate" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                            <TextBlock Grid.Column="1" x:Name="AudioBitrateText" Text="192 kbps" FontSize="10.5" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*,*,*,*">
                                            <Button Grid.Column="0" x:Name="AudRate64Btn" Content="64k" Margin="0,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="AudRate64_Click"/>
                                            <Button Grid.Column="1" x:Name="AudRate128Btn" Content="128k" Margin="1,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="AudRate128_Click"/>
                                            <Button Grid.Column="2" x:Name="AudRate192Btn" Content="192k" Margin="1,0,1,0" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#00D2FF" Foreground="#000000" CornerRadius="12" Padding="0,4" Click="AudRate192_Click"/>
                                            <Button Grid.Column="3" x:Name="AudRate256Btn" Content="256k" Margin="1,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="AudRate256_Click"/>
                                            <Button Grid.Column="4" x:Name="AudRate320Btn" Content="320k" Margin="1,0,0,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="AudRate320_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- 5. PDF DECK -->
                            <StackPanel x:Name="PdfDeckPanel" Spacing="8" IsVisible="False">
                                <Border Background="#18181C" CornerRadius="8" Padding="10" BorderBrush="#242428" BorderThickness="0.5">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="Document Resolution (DPI)" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                                            <TextBlock Grid.Column="1" x:Name="PdfDpiText" Text="150 DPI" FontSize="10.5" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*,*,*">
                                            <Button Grid.Column="0" x:Name="PdfDpi72Btn" Content="72 DPI" Margin="0,0,2,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="PdfDpi72_Click"/>
                                            <Button Grid.Column="1" x:Name="PdfDpi150Btn" Content="150 DPI" Margin="2,0,2,0" FontSize="8.5" FontWeight="SemiBold" Background="#00D2FF" Foreground="#000000" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="12" Padding="0,4" Click="PdfDpi150_Click"/>
                                            <Button Grid.Column="2" x:Name="PdfDpi200Btn" Content="200 DPI" Margin="2,0,2,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="PdfDpi200_Click"/>
                                            <Button Grid.Column="3" x:Name="PdfDpi300Btn" Content="300 DPI" Margin="2,0,0,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="12" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="PdfDpi300_Click"/>
                                        </Grid>
                                        <CheckBox x:Name="PdfGrayscaleCheck" Content="Convert to Grayscale" FontSize="9.5" Foreground="#A0A0B0" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Quick Squeeze Drop Zone -->
                    <Border x:Name="QuickDropBorder"
                            Background="#1F1F23"
                            BorderBrush="#2D2D32"
                            BorderThickness="0.5"
                            CornerRadius="10"
                            Padding="18,14"
                            DragDrop.AllowDrop="True">
                        <StackPanel Spacing="5" HorizontalAlignment="Center">
                            <TextBlock Text="Drop files here for instant compression" FontSize="11" Foreground="#B0B0BE" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" Margin="0,2,0,0">
                                <Border Background="#28282C" CornerRadius="10" Padding="7,2.5" BorderBrush="#2D2D32" BorderThickness="0.5">
                                    <TextBlock x:Name="QuickDropLimitPill" Text="25 MB Limit" FontSize="8.5" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                </Border>
                                <Border Background="#28282C" CornerRadius="10" Padding="7,2.5" BorderBrush="#2D2D32" BorderThickness="0.5">
                                    <TextBlock Text="WebP · HEVC · PDF" FontSize="8.5" Foreground="#6B6B78"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Staged Queue -->
                    <Border Background="#1F1F23"
                            BorderBrush="#27272B"
                            BorderThickness="0.5"
                            CornerRadius="10"
                            Padding="12"
                            DragDrop.AllowDrop="True"
                            x:Name="StagedQueueBorder">
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <TextBlock x:Name="QueueHeaderTitle" Text="Staged Queue (0)" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Clear" FontSize="9" Background="Transparent" Foreground="#6B6B78" Padding="4,2" Margin="0,0,6,0" Click="ClearQueue_Click" BorderThickness="0"/>
                                <Button Grid.Column="2" x:Name="SqueezeAllBtn" Content="Squeeze All" FontSize="10" FontWeight="SemiBold" Background="#00D2FF" Foreground="#000000" CornerRadius="14" Padding="12,5" Click="SqueezeAll_Click"/>
                            </Grid>

                            <ItemsControl x:Name="StagedQueueItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:StagedQueueItem">
                                        <Border Background="#1A1A1E" CornerRadius="8" Padding="9,7" Margin="0,2" BorderBrush="#27272B" BorderThickness="0.5">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2">
                                                    <TextBlock Text="{Binding FileName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E8E8ED" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CustomSettingSummary}" FontSize="9" Foreground="#00D2FF"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Custom" FontSize="9" Background="#28282C" Foreground="#B0B0BE" CornerRadius="4" Padding="6,3" Margin="4,0" BorderBrush="#2D2D32" BorderThickness="0.5" Click="CustomizeItem_Click" Tag="{Binding}"/>
                                                <Button Grid.Column="2" Content="✕" FontSize="9" Background="Transparent" Foreground="#55556A" Padding="4,2" Click="DeleteItem_Click" Tag="{Binding Id}" BorderThickness="0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="EmptyQueueHint" Text="Drag files here to customize per-file settings" FontSize="9.5" Foreground="#44444F" TextAlignment="Center" Margin="0,4"/>
                        </StackPanel>
                    </Border>

                    <!-- Active Processing Jobs -->
                    <Border x:Name="ActiveJobsBorder" Background="#1F1F23" CornerRadius="10" Padding="12" BorderBrush="#27272B" BorderThickness="0.5" IsVisible="False">
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="CURRENT QUEUE" FontSize="9" FontWeight="Bold" Foreground="#6B6B78" FontFamily="Georgia, 'Times New Roman', serif"/>
                                <Button Grid.Column="1" Padding="0" Background="Transparent" BorderThickness="0" Click="CancelAllJobs_Click">
                                    <Border Background="#312023" CornerRadius="10" Padding="6,2.5" BorderBrush="#3D2528" BorderThickness="0.5">
                                        <TextBlock Text="Cancel All" FontSize="9" FontWeight="SemiBold" Foreground="#EF5350"/>
                                    </Border>
                                </Button>
                            </Grid>

                            <ItemsControl x:Name="ActiveJobsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:CompressionJob">
                                        <Border Background="#1A1A1E" CornerRadius="8" Padding="9,7" Margin="0,2" BorderBrush="#27272B" BorderThickness="0.5">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="3">
                                                    <TextBlock Text="{Binding FileName}" FontSize="10.5" FontWeight="Medium" Foreground="#E8E8ED" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="1" Height="3" Background="#28282C" Foreground="#00D2FF" CornerRadius="1.5"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#172C35" CornerRadius="10" Padding="6,2" Margin="6,0,0,0" BorderBrush="#1A3845" BorderThickness="0.5">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="9" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="✕" FontSize="9" Background="Transparent" Foreground="#55556A" Padding="3,2" Click="CancelSingleJob_Click" Tag="{Binding Id}" BorderThickness="0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Recent History -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="PROJECTS &amp; RECENT" FontSize="9" FontWeight="Bold" Foreground="#6B6B78" Margin="0,4,0,0" FontFamily="Georgia, 'Times New Roman', serif"/>

                        <ItemsControl x:Name="HistoryItemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:CompressionResult">
                                    <Border Background="#1F1F23" CornerRadius="8" Padding="9,7" Margin="0,2" BorderBrush="#27272B" BorderThickness="0.5">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding FileName}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif" TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="{Binding FormattedOriginalSize}" FontSize="8.5" Foreground="#55556A"/>
                                                    <TextBlock Text="→" FontSize="8.5" Foreground="#44444F"/>
                                                    <TextBlock Text="{Binding FormattedCompressedSize}" FontSize="8.5" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="#1F2E28" CornerRadius="10" Padding="6,2.5" Margin="4,0" BorderBrush="#243A2E" BorderThickness="0.5">
                                                <TextBlock Text="{Binding PercentSaved, StringFormat='-{0:F0}%'}" FontSize="9" FontWeight="Bold" Foreground="#4ADE80"/>
                                            </Border>

                                            <Button Grid.Column="2" Padding="0" Background="Transparent" BorderThickness="0" Click="OpenFolder_Click" Tag="{Binding OutputPath}">
                                                <Border Background="#28282C" CornerRadius="4" Padding="6,3" BorderBrush="#2D2D32" BorderThickness="0.5">
                                                    <TextBlock Text="Open" FontSize="9" Foreground="#A0A0B0"/>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- ━━━━ SETTINGS TAB ━━━━ -->
                <StackPanel x:Name="SettingsTabPanel" Spacing="10" IsVisible="False">

                    <!-- Theme Accent Color — macOS Swatch Circles -->
                    <Border Background="#1F1F23" CornerRadius="10" Padding="14" BorderBrush="#27272B" BorderThickness="0.5">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Theme Accent Color" FontSize="11.5" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="ThemeColorLabel" Text="Cyan" FontSize="10" FontWeight="SemiBold" Foreground="#00D2FF" VerticalAlignment="Center"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                                <Button x:Name="ColorBallCyan" Width="28" Height="28" CornerRadius="14" Background="#00D2FF" BorderBrush="#FFFFFF" BorderThickness="2" Padding="0" Click="ThemeCyan_Click"/>
                                <Button x:Name="ColorBallEmerald" Width="22" Height="22" CornerRadius="11" Background="#00E676" BorderBrush="Transparent" BorderThickness="0" Padding="0" Click="ThemeEmerald_Click"/>
                                <Button x:Name="ColorBallPurple" Width="22" Height="22" CornerRadius="11" Background="#A855F7" BorderBrush="Transparent" BorderThickness="0" Padding="0" Click="ThemePurple_Click"/>
                                <Button x:Name="ColorBallSunset" Width="22" Height="22" CornerRadius="11" Background="#FF9500" BorderBrush="Transparent" BorderThickness="0" Padding="0" Click="ThemeSunset_Click"/>
                                <Button x:Name="ColorBallRose" Width="22" Height="22" CornerRadius="11" Background="#FF2D55" BorderBrush="Transparent" BorderThickness="0" Padding="0" Click="ThemeRose_Click"/>
                                <Button x:Name="ColorBallBlue" Width="22" Height="22" CornerRadius="11" Background="#007AFF" BorderBrush="Transparent" BorderThickness="0" Padding="0" Click="ThemeBlue_Click"/>
                                <Button x:Name="ColorBallCustom" Width="22" Height="22" CornerRadius="11" Background="#5856D6" Padding="0" Click="ThemeCustom_Click" BorderBrush="Transparent" BorderThickness="0">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <TextBlock Text="Personalize highlight colors, buttons, and glow indicators." FontSize="8.5" Foreground="#55556A"/>
                        </StackPanel>
                    </Border>

                    <!-- Save Destination & Suffix -->
                    <Border Background="#1F1F23" CornerRadius="10" Padding="14" BorderBrush="#27272B" BorderThickness="0.5">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Save Destination" FontSize="11.5" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                            <StackPanel Spacing="4">
                                <TextBlock Text="Filename Suffix" FontSize="9.5" Foreground="#6B6B78"/>
                                <TextBox x:Name="SettingsSuffixBox" Text="_squeezed" Background="#28282C" Foreground="#E8E8ED" BorderBrush="#2D2D32" CornerRadius="6" Padding="8,5"/>
                            </StackPanel>
                            <CheckBox x:Name="ReplaceOriginalCheck" Content="Replace original file (destructive)" FontSize="10" Foreground="#A0A0B0"/>
                            <CheckBox x:Name="StripMetadataCheck" Content="Strip EXIF &amp; GPS location metadata" IsChecked="True" FontSize="10" Foreground="#A0A0B0"/>
                        </StackPanel>
                    </Border>

                    <!-- Auto-Squeeze Watch Folder -->
                    <Border Background="#1F1F23" CornerRadius="10" Padding="14" BorderBrush="#27272B" BorderThickness="0.5">
                        <StackPanel Spacing="7">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Auto-Squeeze Watch Folder" FontSize="11.5" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Padding="0" Background="Transparent" BorderThickness="0" Click="AddWatchedFolder_Click">
                                    <Border Background="#28282C" CornerRadius="12" Padding="8,3" BorderBrush="#2D2D32" BorderThickness="0.5">
                                        <TextBlock Text="+ Add Folder" FontSize="9" FontWeight="SemiBold" Foreground="#00D2FF"/>
                                    </Border>
                                </Button>
                            </Grid>
                            <TextBlock Text="Monitors folder and automatically compresses any new media file." FontSize="8.5" Foreground="#55556A"/>

                            <ItemsControl x:Name="WatchedFoldersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="x:String">
                                        <Border Background="#1A1A1E" CornerRadius="6" Padding="8,5" Margin="0,2" BorderBrush="#27272B" BorderThickness="0.5">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding}" FontSize="9" Foreground="#A0A0B0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontFamily="Consolas, 'Courier New', monospace"/>
                                                <Button Grid.Column="1" Content="✕" FontSize="9" Background="Transparent" Foreground="#55556A" Padding="3,2" Click="RemoveWatchedFolder_Click" Tag="{Binding}" BorderThickness="0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="EmptyWatchedHint" Text="No watched folders configured" FontSize="9" Foreground="#44444F" TextAlignment="Center" Margin="0,2"/>
                        </StackPanel>
                    </Border>

                    <!-- Lifetime Storage Metrics -->
                    <Border Background="#1F1F23" CornerRadius="10" Padding="14" BorderBrush="#27272B" BorderThickness="0.5">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Lifetime Storage Metrics" FontSize="11.5" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="TOTAL SPACE SAVED" FontSize="8" FontWeight="Bold" Foreground="#55556A"/>
                                    <TextBlock x:Name="LifetimeSavedText" Text="0 MB" FontSize="16" FontWeight="Bold" Foreground="#00D2FF"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="FILES OPTIMIZED" FontSize="8" FontWeight="Bold" Foreground="#55556A"/>
                                    <TextBlock x:Name="LifetimeFilesText" Text="0 files" FontSize="16" FontWeight="Bold" Foreground="#E8E8ED"/>
                                </StackPanel>
                            </Grid>
                            <Button Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" Click="ResetStats_Click">
                                <Border Background="#312023" CornerRadius="10" Padding="7,3" BorderBrush="#3D2528" BorderThickness="0.5">
                                    <TextBlock Text="Reset Statistics" FontSize="9" Foreground="#EF5350"/>
                                </Border>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ════════════════════════════════════════════════════ -->
        <!-- 4. FOOTER                                           -->
        <!-- ════════════════════════════════════════════════════ -->
        <Border Grid.Row="3" Padding="20,7,20,9" BorderBrush="#222226" BorderThickness="0,0.5,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <TextBlock x:Name="SavedStatsText" Text="0 MB Saved" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="·" FontSize="9" Foreground="#44444F"/>
                    <TextBlock x:Name="FooterStatusText" Text="Ready" FontSize="9" Foreground="#55556A"/>
                    <TextBlock Text="·" FontSize="9" Foreground="#44444F"/>
                    <TextBlock Text="SqueezeBar v0.98" FontSize="8.5" Foreground="#44444F"/>
                </StackPanel>
                <Button Grid.Column="1" Padding="0" Background="Transparent" BorderThickness="0" Click="QuitBtn_Click">
                    <Border Background="#242428" CornerRadius="4" Padding="8,2.5" BorderBrush="#2D2D32" BorderThickness="0.5">
                        <TextBlock Text="Quit" FontSize="9" Foreground="#7A7A8A"/>
                    </Border>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
