<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SqueezeBar.Models"
        x:Class="SqueezeBar.Views.QueueItemSettingsDialog"
        Title="Per-File Settings"
        Width="370" Height="460"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1E"
        Foreground="#E8E8ED">

    <Window.Resources>
        <x:Double x:Key="SliderThumbWidth">11</x:Double>
        <x:Double x:Key="SliderThumbHeight">11</x:Double>
        <x:Double x:Key="SliderThumbWidthPointerOver">12</x:Double>
        <x:Double x:Key="SliderThumbHeightPointerOver">12</x:Double>
        <x:Double x:Key="SliderThumbWidthPressed">12</x:Double>
        <x:Double x:Key="SliderThumbHeightPressed">12</x:Double>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Slider">
            <Setter Property="MinHeight" Value="16"/>
        </Style>
        <Style Selector="Slider /template/ Thumb">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="CornerRadius" Value="5.5"/>
            <Setter Property="Background" Value="#00D2FF"/>
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <!-- Ultra-Minimalist Solid Indicator CheckBox -->
        <Style Selector="CheckBox">
            <Setter Property="MinHeight" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="Auto,*" Background="Transparent" VerticalAlignment="Center">
                        <Border Name="CheckBorder"
                                Width="11" Height="11"
                                CornerRadius="2.5"
                                BorderThickness="1"
                                BorderBrush="#3E3E48"
                                Background="#1A1A1E"
                                VerticalAlignment="Center"/>
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          Margin="6,0,0,0"
                                          FontSize="9"
                                          Foreground="#8E8E9E"
                                          VerticalAlignment="Center"/>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#CheckBorder">
            <Setter Property="Background" Value="#00D2FF"/>
            <Setter Property="BorderBrush" Value="#00D2FF"/>
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#CheckBorder">
            <Setter Property="BorderBrush" Value="#00D2FF"/>
        </Style>
        <Style Selector="CheckBox:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#E8E8ED"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="18,16,18,14">
        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,0,0,10" BorderBrush="#27272B" BorderThickness="0,0,0,0.5">
            <StackPanel Spacing="3">
                <TextBlock x:Name="FileNameText" Text="File Name" FontWeight="Bold" FontSize="13" Foreground="#F0F0F5" FontFamily="Georgia, 'Times New Roman', serif" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="FileSizeText" Text="12.4 MB • MP4" FontSize="10" Foreground="#6B6B78"/>
            </StackPanel>
        </Border>

        <!-- Dynamic Settings Body -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <!-- Quality Slider -->
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="QualityTitleText" Text="Quality" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                        <TextBlock Grid.Column="1" x:Name="QualityPercentText" Text="80%" FontSize="10.5" FontWeight="SemiBold" Foreground="#00D2FF"/>
                    </Grid>
                    <Slider x:Name="QualitySlider" Minimum="0.10" Maximum="1.0" Value="0.80" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                </StackPanel>

                <!-- Resolution Scale (Images & Video) -->
                <StackPanel x:Name="ResolutionScalePanel" Spacing="5">
                    <TextBlock Text="Resolution Scale" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                    <Grid ColumnDefinitions="*,*,*,*">
                        <Button Grid.Column="0" x:Name="Scale100Btn" Content="100%" Margin="0,0,1,0" FontSize="8.5" FontWeight="SemiBold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#00D2FF" Foreground="#000000" CornerRadius="4" Padding="0,4" Click="Scale100_Click"/>
                        <Button Grid.Column="1" x:Name="Scale75Btn" Content="75%" Margin="1,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="4" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Scale75_Click"/>
                        <Button Grid.Column="2" x:Name="Scale50Btn" Content="50%" Margin="1,0,1,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="4" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Scale50_Click"/>
                        <Button Grid.Column="3" x:Name="Scale25Btn" Content="25%" Margin="1,0,0,0" FontSize="8.5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="4" Padding="0,4" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Scale25_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Target Size Limit -->
                <StackPanel Spacing="5">
                    <TextBlock Text="Target Size Limit" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                    <Grid ColumnDefinitions="*,*,*,*">
                        <Button Grid.Column="0" x:Name="LimitOffBtn" Content="Off" Margin="0,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="9" FontWeight="SemiBold" Background="#00D2FF" Foreground="#000000" CornerRadius="14" Padding="0,5" Click="LimitOff_Click"/>
                        <Button Grid.Column="1" x:Name="Limit25Btn" Content="25 MB" Margin="2,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="9" Background="#28282C" Foreground="#A0A0B0" CornerRadius="14" Padding="0,5" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Limit25_Click"/>
                        <Button Grid.Column="2" x:Name="Limit10Btn" Content="10 MB" Margin="2,0,2,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="9" Background="#28282C" Foreground="#A0A0B0" CornerRadius="14" Padding="0,5" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Limit10_Click"/>
                        <Button Grid.Column="3" x:Name="Limit50Btn" Content="50 MB" Margin="2,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" FontSize="9" Background="#28282C" Foreground="#A0A0B0" CornerRadius="14" Padding="0,5" BorderBrush="#2D2D32" BorderThickness="0.5" Click="Limit50_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Media Specific Format Controls -->

                <!-- 1. Image Format -->
                <StackPanel x:Name="ImageFormatPanel" Spacing="4">
                    <TextBlock Text="Output Format" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                    <ComboBox x:Name="ImageFormatCombo" HorizontalAlignment="Stretch" FontSize="10" Background="#28282C" BorderBrush="#2D2D32">
                        <ComboBoxItem Content="Modern WebP"/>
                        <ComboBoxItem Content="Web JPEG"/>
                        <ComboBoxItem Content="Preserve Original"/>
                    </ComboBox>
                </StackPanel>

                <!-- 2. Video Codec -->
                <StackPanel x:Name="VideoCodecPanel" Spacing="4" IsVisible="False">
                    <TextBlock Text="Video Codec" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                    <ComboBox x:Name="VideoCodecCombo" HorizontalAlignment="Stretch" FontSize="10" Background="#28282C" BorderBrush="#2D2D32">
                        <ComboBoxItem Content="HEVC (H.265)"/>
                        <ComboBoxItem Content="H.264"/>
                        <ComboBoxItem Content="Animated GIF"/>
                    </ComboBox>
                </StackPanel>

                <!-- 3. Audio Bitrate -->
                <StackPanel x:Name="AudioBitratePanel" Spacing="4" IsVisible="False">
                    <TextBlock Text="Audio Bitrate" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                    <ComboBox x:Name="AudioBitrateCombo" HorizontalAlignment="Stretch" FontSize="10" Background="#28282C" BorderBrush="#2D2D32">
                        <ComboBoxItem Content="64 kbps · Voice"/>
                        <ComboBoxItem Content="128 kbps · Standard"/>
                        <ComboBoxItem Content="192 kbps · High Quality"/>
                        <ComboBoxItem Content="256 kbps · Studio"/>
                        <ComboBoxItem Content="320 kbps · Maximum"/>
                    </ComboBox>
                </StackPanel>

                <!-- 4. PDF DPI -->
                <StackPanel x:Name="PdfDpiPanel" Spacing="5" IsVisible="False">
                    <TextBlock Text="PDF Target DPI" FontSize="11" FontWeight="Bold" Foreground="#E8E8ED" FontFamily="Georgia, 'Times New Roman', serif"/>
                    <Grid ColumnDefinitions="*,*,*,*">
                        <Button Grid.Column="0" x:Name="PdfDpi72Btn" Content="72" Margin="0,0,2,0" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="14" Padding="0,5" BorderBrush="#2D2D32" BorderThickness="0.5" Click="PdfDpi72_Click"/>
                        <Button Grid.Column="1" x:Name="PdfDpi150Btn" Content="150" Margin="2,0,2,0" FontSize="9" FontWeight="SemiBold" Background="#00D2FF" Foreground="#000000" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" CornerRadius="14" Padding="0,5" Click="PdfDpi150_Click"/>
                        <Button Grid.Column="2" x:Name="PdfDpi200Btn" Content="200" Margin="2,0,2,0" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="14" Padding="0,5" BorderBrush="#2D2D32" BorderThickness="0.5" Click="PdfDpi200_Click"/>
                        <Button Grid.Column="3" x:Name="PdfDpi300Btn" Content="300" Margin="2,0,0,0" FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="#28282C" Foreground="#A0A0B0" CornerRadius="14" Padding="0,5" BorderBrush="#2D2D32" BorderThickness="0.5" Click="PdfDpi300_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Strip Metadata -->
                <CheckBox x:Name="StripMetadataCheck" Content="Strip EXIF / GPS Metadata" IsChecked="True" FontSize="10.5" Foreground="#A0A0B0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="0,8,0,0" BorderBrush="#27272B" BorderThickness="0,0.5,0,0">
            <Button Content="Done" HorizontalAlignment="Right" Background="#00D2FF" Foreground="#000000" FontWeight="Bold" FontSize="10.5" Padding="18,6" CornerRadius="14" Click="Done_Click"/>
        </Border>
    </Grid>
</Window>
